# Local port for `npm start` (ignored on Vercel)
PORT=3000

# Supabase (Project Settings -> API). Server-side only; never expose the service role key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Private Storage bucket for photos
SUPABASE_BUCKET=wardrobe

# Signs the session cookie (JWT). Required in production; use a long random string,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 when served over HTTPS (always 1 on Vercel)
COOKIE_SECURE=0

# Optional. Turns on AI detection, tagging and try-on (without it, the app runs in demo mode)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
